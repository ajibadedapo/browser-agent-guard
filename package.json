{
  "name": "browser-agent-guard",
  "version": "0.1.0",
  "description": "Detect AI agents driving a browser on your website",
  "license": "MIT",
  "author": "Hammed Ajibade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajibadedapo/browser-agent-guard.git"
  },
  "homepage": "https://ajibadedapo.github.io/browser-agent-guard/",
  "bugs": {
    "url": "https://github.com/ajibadedapo/browser-agent-guard/issues"
  },
  "keywords": [
    "ai-agent",
    "browser-agent",
    "bot-detection",
    "agent-detection",
    "automation-detection",
    "web-bot-auth",
    "claude",
    "chatgpt-agent",
    "playwright",
    "security"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./auto": "./dist/browser/auto.global.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/browser/*.js"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/check-size.ts",
    "test": "vitest run --silent",
    "size": "npm run build",
    "fixtures:spike": "node scripts/convert-spike.ts",
    "demo:build": "tsup --config demo/tsup.config.ts",
    "bench": "node --import ./bench/resolve-typescript.ts bench/run.ts",
    "fixtures:playwright": "npm run demo:build && node scripts/record-playwright.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.3",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
